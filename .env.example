# Copy this file to .env only when you need to override the local defaults.
MYSQL_ROOT_PASSWORD=root
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional external integrations. The application starts without working credentials,
# but pipeline execution and email delivery require real values.
JENKINS_URL=http://host.docker.internal:8080
JENKINS_USERNAME=admin
JENKINS_API_TOKEN=docker-local-disabled
MAIL_USERNAME=disabled@localhost
MAIL_PASSWORD=docker-local-disabled

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

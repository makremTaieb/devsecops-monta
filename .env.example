# Copy this file to .env only when you need to override the local defaults.
MYSQL_ROOT_PASSWORD=root
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional external integrations. The application starts without working credentials,
# but pipeline execution and email delivery require real values.
JENKINS_URL=http://stb-jenkins:8080
JENKINS_USERNAME=admin
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin
# Fixed local API token used by Pipeline-Service. Change it outside a demo environment.
JENKINS_API_TOKEN=110123456789abcdef0123456789abcdef
GITHUB_REPOSITORY_URL=https://github.com/makremTaieb/devsecops-monta.git

SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar
SONAR_DB_NAME=sonar
SONAR_ADMIN_PASSWORD=admin-local
SONAR_PORT=9001

NEXUS_ADMIN_PASSWORD=admin-local
NEXUS_PORT=8086
NEXUS_DOCKER_PORT=5000
MAIL_USERNAME=disabled@localhost
MAIL_PASSWORD=docker-local-disabled

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
